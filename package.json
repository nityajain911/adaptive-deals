{
  "name": "adaptive-deals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:release": "tsx scripts/check-release.ts",
    "reset:seed": "tsx --conditions=react-server scripts/reset-seed.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/run-dev-eval.ts",
    "eval:frozen": "tsx --env-file-if-exists=.env.local scripts/run-frozen-eval.ts",
    "eval:memory": "tsx --env-file-if-exists=.env.local scripts/run-commercial-memory-eval.ts",
    "hero:report": "tsx scripts/hero-report.ts",
    "replay:build": "tsx scripts/build-synthetic-replay.ts",
    "mcp:discover": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/mcp-discover.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
