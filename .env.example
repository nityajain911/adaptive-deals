# Copy to .env.local. The app runs fully without any of these (synthetic replay + simulation).

# Live model for "Run live" (optional). Leave the selected provider's key empty to use the bundled synthetic replay.
# Provider selection is backend-only and takes effect after a server restart. The product has no provider selector.
# Default: Cerebras with gpt-oss-120b and strict JSON-schema output.
ADAPTIVE_DEALS_PROVIDER=cerebras
ADAPTIVE_DEALS_MODEL=gpt-oss-120b
CEREBRAS_API_KEY=
# Two features try Cerebras first and then Groq whenever those keys are set: reading a rate card that has no recording, and
# suggesting a reading of a payment reply the rules cannot read (e.g. "20 tak"). With neither key they use recorded values or
# the built-in rules. The merchant never sees which provider answered.
# Alternatives: set ADAPTIVE_DEALS_PROVIDER=groq with GROQ_API_KEY, or anthropic with ANTHROPIC_API_KEY.
GROQ_API_KEY=
# Turn off live reading of new rate cards (the recorded sample documents are always replayed): ADAPTIVE_DEALS_DOCUMENT_AI=off
ANTHROPIC_API_KEY=

# Razorpay TEST MODE for the upfront payment link (optional).
# Only keys starting rzp_test_ are accepted; rzp_live_ and other forms are refused.
# Recurring payments are always simulated in this prototype.
RAZORPAY_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: where the local JSON store lives (default ./.data, git-ignored).
ADAPTIVE_DEALS_DATA_DIR=

# Razorpay MCP (optional, test mode only). Needs the rzp_test_ pair above and RAZORPAY_MODE is not required.
# remote = Razorpay's hosted MCP server; stdio = a local server you run (default: the razorpay/mcp Docker image).
# Leave empty to keep the Razorpay action honestly marked "not connected". Run `npm run mcp:discover` first: it is read-only.
RAZORPAY_MCP_MODE=
# stdio only, optional: RAZORPAY_MCP_COMMAND=/path/to/razorpay-mcp-server  RAZORPAY_MCP_ARGS=["stdio"]
